import React from 'react';
import { AbsoluteFill, interpolate, useCurrentFrame } from 'remotion';
import { FontFaces } from './FontFaces';
import { textStrokeStyle, textFillStyle } from './textStroke';
import {
  easings,
  eased,
  getTextTransition,
} from './motionEngine';
import { CinematicBackground } from './CinematicBackground';
import { OverlayLayer } from './OverlayLayer';
import { PremiumCover } from './PremiumCover';
import { PlatformLogo } from './PlatformLogo';
import {
  DEFAULT_FONTS,
  findFont,
  applyTextStyle,
  applyGradientStyle,
  hasGradient,
  userTextTransform,
} from '../lib/fontCatalog';
import { Watermark } from './Watermark';
import type { TemplateProps, TextTransitionId } from './types';

/* ---------- timings ---------- */
const HEADLINE_IN = 14;
const DATE_IN = 36;
const COVER_IN = 60;
const TITLE_IN = 96;
const CTA_IN = 124;
const PLATFORMS_IN = 156;

export const AvailableNow: React.FC<TemplateProps> = (props) => {
  const frame = useCurrentFrame();
  const motion: any = props.motion ?? {};

  const fontHeadline = findFont(
    motion.fontHeadline ?? 'BurbankBig-Black',
    motion.customFonts ?? [],
  );
  const fontDate = findFont(
    motion.fontDate ?? 'Authority-Rounded',
    motion.customFonts ?? [],
  );
  const fontCta = findFont(
    motion.fontCta ?? 'TuskerGrotesk-8800Super',
    motion.customFonts ?? [],
  );

  const ff = (family?: string) =>
    family ? `'${family}', Arial, sans-serif` : 'Arial, sans-serif';

  /* ---------- transitions ---------- */
  const txHeadline: TextTransitionId =
    motion.transitionHeadline ?? 'mask_reveal';
  const txDate: TextTransitionId = motion.transitionDate ?? 'scale_pop';
  const txCta: TextTransitionId = motion.transitionCta ?? 'split_letters';

  const tH = getTextTransition(txHeadline)(frame, HEADLINE_IN);
  const tD = getTextTransition(txDate)(frame, DATE_IN);
  const tC = getTextTransition(txCta)(frame, CTA_IN);

  /* ---------- cover anim ---------- */
  const coverScale = interpolate(
    frame,
    [COVER_IN, COVER_IN + 26],
    [0.7, 1],
    { extrapolateRight: 'clamp', easing: easings.easeOutCubic },
  );
  const coverOpacity = eased(frame, COVER_IN, 22);

  const titleOpacity = eased(frame, TITLE_IN, 18);
  const titleY = interpolate(frame, [TITLE_IN, TITLE_IN + 18], [16, 0], {
    extrapolateRight: 'clamp',
    easing: easings.easeOutCubic,
  });

  const platformsAnim = eased(frame, PLATFORMS_IN, 18);

  /* ---------- texts ---------- */
  const headlineText = (props.headline || 'LANÇAMENTO').toUpperCase();
  const dateText = props.releaseDate || '';
  const ctaText = (props.cta || 'FAÇA O PRÉ-SAVE').toUpperCase();
  const platformsSubtitle =
    props.cta2 || 'EM TODAS AS PLATAFORMAS DIGITAIS';

  const showAll = false;
  const visiblePlatforms = props.platforms ?? [];

  /* ---------- color defaults ---------- */
  const accentColor =
    motion.accentColor || motion.styleHeadline?.color || '#FFD667';
  const textColor = motion.styleHeadline?.color || '#FFFFFF';

  return (
    <AbsoluteFill
      style={{
        background: motion.bgColor || '#0a0a0a',
        fontFamily: 'Inter, Arial, sans-serif',
        color: '#fff',
        overflow: 'hidden',
      }}
    >
      <FontFaces
        fonts={motion.customFonts}
        activeFontIds={[
          motion.fontHeadline ?? '',
          motion.fontDate ?? '',
          motion.fontCta ?? '',
        ]}
      />

      <CinematicBackground frame={frame} motion={motion} media={props.media} />
      <OverlayLayer frame={frame} motion={motion} />

      {/* ===================== STACK CENTRAL ===================== */}
      <AbsoluteFill
        style={{
          display: 'flex',
          flexDirection: 'column',
          alignItems: 'center',
          justifyContent: 'center',
          padding: '120px 60px',
          textAlign: 'center',
          gap: 28,
        }}
      >
        {/* ----- HEADLINE: "LANÇAMENTO" ----- */}
        <div
          style={{
            fontFamily: ff(fontHeadline?.family),
            fontWeight: fontHeadline?.weight ?? 900,
            fontSize: 140,
            lineHeight: 0.92,
            letterSpacing: -1,
            color: textColor,
            textShadow:
              motion.strokeHeadline?.mode &&
              motion.strokeHeadline.mode !== 'none'
                ? 'none'
                : '0 14px 36px rgba(0,0,0,0.92)',
            overflow: 'visible',
            ...applyTextStyle(motion.styleHeadline),
            ...textStrokeStyle(motion.strokeHeadline),
            ...(showAll ? {} : tH.wrapStyle),
            ...userTextTransform(motion.styleHeadline, tH.wrapStyle),
          }}
        >
          {headlineText}
        </div>

        {/* ----- DATA: "07.NOVEMBRO" — TEXTO PURO, SEM CAIXA ----- */}
        {dateText ? (
          <div
            style={{
              fontFamily: ff(fontDate?.family),
              fontWeight: fontDate?.weight ?? 700,
              fontSize: 56,
              letterSpacing: 1.5,
              color: accentColor,
              marginTop: -8,
              textShadow: '0 8px 24px rgba(0,0,0,0.6)',
              ...applyTextStyle(motion.styleDate),
              ...textStrokeStyle(motion.strokeDate),
              ...(showAll ? {} : tD.wrapStyle),
              ...userTextTransform(motion.styleDate, tD.wrapStyle),
            }}
          >
            {dateText}
          </div>
        ) : null}

        {/* ----- CAPA QUADRADA ----- */}
        {props.coverImage ? (
          <div
            style={{
              opacity: coverOpacity,
              transform: `scale(${coverScale})`,
              marginTop: 24,
              marginBottom: 24,
              filter: 'drop-shadow(0 30px 60px rgba(0,0,0,0.55))',
            }}
          >
            <PremiumCover src={props.coverImage} size={520} />
          </div>
        ) : null}

        {/* ----- TÍTULO + ARTISTA (opcionais, viram do songTitle/artistName) ----- */}
        {props.songTitle || props.artistName ? (
          <div
            style={{
              opacity: titleOpacity,
              transform: `translateY(${titleY}px)`,
              display: 'flex',
              flexDirection: 'column',
              alignItems: 'center',
              gap: 4,
              marginTop: -8,
              marginBottom: 12,
            }}
          >
            {props.songTitle ? (
              <div
                style={{
                  fontFamily: ff(fontHeadline?.family),
                  fontWeight: 800,
                  fontSize: 48,
                  letterSpacing: 0.5,
                  color: '#fff',
                  textShadow: '0 6px 20px rgba(0,0,0,0.7)',
                }}
              >
                {props.songTitle.toUpperCase()}
              </div>
            ) : null}
            {props.artistName ? (
              <div
                style={{
                  fontFamily: ff(fontDate?.family),
                  fontWeight: 600,
                  fontSize: 28,
                  letterSpacing: 1.2,
                  color: 'rgba(255,255,255,0.85)',
                }}
              >
                {props.artistName}
              </div>
            ) : null}
          </div>
        ) : null}

        {/* ----- CTA: "FAÇA O PRÉ-SAVE" ----- */}
        <div
          style={{
            fontFamily: ff(fontCta?.family),
            fontWeight: fontCta?.weight ?? 900,
            fontSize: 64,
            lineHeight: 1.0,
            letterSpacing: 2.6,
            color: textColor,
            textShadow: '0 6px 24px rgba(0,0,0,0.92)',
            marginTop: 16,
            ...applyTextStyle(motion.styleCta),
            ...textStrokeStyle(motion.strokeCta),
            ...(showAll ? {} : tC.wrapStyle),
            ...userTextTransform(motion.styleCta, tC.wrapStyle),
          }}
        >
          {ctaText}
        </div>

        {/* ----- SUBTÍTULO: "EM TODAS AS PLATAFORMAS DIGITAIS" ----- */}
        <div
          style={{
            fontFamily: ff(fontCta?.family),
            fontWeight: 700,
            fontSize: 22,
            letterSpacing: 3.4,
            color: 'rgba(255,255,255,0.8)',
            marginTop: -10,
            opacity: platformsAnim,
          }}
        >
          {platformsSubtitle.toUpperCase()}
        </div>

        {/* ----- LOGOS DAS PLATAFORMAS ----- */}
        {visiblePlatforms.length > 0 ? (
          <div
            style={{
              display: 'flex',
              gap: 28,
              alignItems: 'center',
              justifyContent: 'center',
              marginTop: 16,
              opacity: platformsAnim,
            }}
          >
            {visiblePlatforms.map((p, i) => (
              <PlatformLogo
                key={`pl-${p}`}
                name={p}
                delay={PLATFORMS_IN + i * 4}
                frame={frame}
                customLogos={motion.platformLogos}
                scaleOverride={motion.platformLogoScales?.[p]}
              />
            ))}
          </div>
        ) : null}
      </AbsoluteFill>

      {/* ===================== WATERMARK ===================== */}
      <Watermark {...(motion.watermark ?? {})} />
    </AbsoluteFill>
  );
};

export default AvailableNow;
