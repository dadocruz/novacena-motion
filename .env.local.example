# ============================================================
# NovaCena Motion — variáveis de ambiente
# ============================================================
# Copie este arquivo para .env.local e preencha as keys que tiver.
# Não precisa preencher TODAS — o sistema escolhe automaticamente
# o melhor provider disponível (fallback chain).

# ------------------------------------------------------------
# AI Providers (pelo menos UM é recomendado)
# ------------------------------------------------------------
# Claude (Anthropic) — melhor pra criatividade + raciocínio.
# Pegue em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo (default: claude-sonnet-4-6)
# Opções: claude-opus-4-7 (mais caro, mais inteligente)
NOVACENA_CLAUDE_MODEL=

# OpenAI GPT-4o — excelente vision + bom custo
# Pegue em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo (default: gpt-4o)
# Opções: gpt-4o-mini (mais barato), gpt-4-turbo
NOVACENA_OPENAI_MODEL=

# Google Gemini — mais barato e rápido, ótimo pra alta volume
# Pegue em: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=

# Modelo (default: gemini-1.5-flash)
# Opções: gemini-1.5-pro (mais caro, mais inteligente)
NOVACENA_GEMINI_MODEL=

# ------------------------------------------------------------
# AI Provider customizado (HTTP endpoint próprio)
# ------------------------------------------------------------
NOVACENA_CUSTOM_AI_ENDPOINT=
NOVACENA_CUSTOM_AI_KEY=

# ------------------------------------------------------------
# Origin do app (necessário pra render achar uploads)
# ------------------------------------------------------------
# Default: http://localhost:3000
# Em prod: https://seudominio.com.br
NOVACENA_APP_ORIGIN=

# Remotion Lambda / AWS
REMOTION_AWS_REGION=us-east-1
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_LAMBDA_SERVE_URL=
REMOTION_LAMBDA_BUCKET_NAME=
REMOTION_LAMBDA_COMPOSITION=AvailableNow
